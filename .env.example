# Environment variable names only — DO NOT put secrets or real values here.

# Supabase (client/public)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase (server-side)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (server-only)
AI_PROVIDER=
OPENAI_API_KEY=
AI_MODEL=
AI_API_BASE_URL=

# Optional migration / target Supabase (used during migration)
TARGET_SUPABASE_URL=
TARGET_SUPABASE_PUBLISHABLE_KEY=
TARGET_SUPABASE_SERVICE_ROLE_KEY=

# Observability (server or client depending on use)
SENTRY_DSN=

# Runtime / deployment
NODE_ENV=
VITE_PUBLIC_URL=

# Email provider (if used)
EMAIL_PROVIDER=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=

# Other
LOG_LEVEL=

# Notes:
# - Never commit real secret values to the repository.
# - All server-only secrets must be stored in GitHub Actions Secrets and
#   injected into the runtime (Azure App Service) via the portal or CI.
